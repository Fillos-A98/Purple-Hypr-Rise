{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "#F6BCFD"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "#F6BCFD"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "#DC90E2"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "#DC90E2",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "#DC90E2"

        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "#DC90E2"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;233;198;245m└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
