{
   "include": [
     "$HOME/.config/waybar/Modules",
     "$HOME/.config/waybar/ModulesCustom"
     ],

    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "width": 1900,
    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "hyprland/language"],
    "sway/window": {
        "max-length": 50
    }
    
 
}

